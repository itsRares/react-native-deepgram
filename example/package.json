{
  "name": "react-native-deepgram-example",
  "version": "1.0.0",
  "private": true,
  "main": "index.js",
  "scripts": {
    "start": "expo start --clear",
    "ios": "expo run:ios",
    "android": "expo run:android",
    "ios:device": "expo run:ios --device",
    "prebuild": "expo prebuild --clean",
    "pods": "cd ios && pod install && cd ..",
    "start:built": "DEEPGRAM_USE_BUILT=1 expo start --clear",
    "clean": "expo prebuild --clean && rm -rf ios/build android/build .expo node_modules/.cache"
  },
  "dependencies": {
    "@expo/metro-runtime": "~58.0.17",
    "expo": "~58.0.23",
    "expo-build-properties": "~58.0.12",
    "expo-document-picker": "~58.0.4",
    "expo-file-system": "~58.0.13",
    "react": "19.3.0",
    "react-dom": "19.3.0",
    "react-native": "0.88.1",
    "react-native-deepgram": "workspace:*"
  },
  "devDependencies": {
    "@babel/core": "^7.29.7",
    "@react-native/typescript-config": "0.88.1",
    "babel-plugin-module-resolver": "^5.0.2",
    "typescript": "^6.0.3"
  }
}
