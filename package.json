{
  "name": "react-native-deepgram",
  "version": "3.0.0",
  "description": "React Native SDK for Deepgram's AI-powered speech-to-text, real-time transcription, and text intelligence APIs. Supports live audio streaming, file transcription, sentiment analysis, and topic detection for iOS and Android.",
  "source": "./src/index.ts",
  "main": "./lib/module/index.js",
  "types": "./lib/typescript/src/index.d.ts",
  "exports": {
    ".": {
      "react-native-deepgram-source": "./src/index.ts",
      "types": "./lib/typescript/src/index.d.ts",
      "default": "./lib/module/index.js"
    },
    "./app.plugin.js": "./app.plugin.js",
    "./package.json": "./package.json"
  },
  "files": [
    "src",
    "lib",
    "plugin/build",
    "plugin/src",
    "plugin/tsconfig.json",
    "app.plugin.js",
    "android",
    "ios",
    "react-native.config.js",
    "*.podspec",
    "!ios/build",
    "!ios/generated/build",
    "!android/build",
    "!android/generated",
    "!android/gradle",
    "!android/gradlew",
    "!android/gradlew.bat",
    "!android/local.properties",
    "!**/__tests__",
    "!**/__fixtures__",
    "!**/__mocks__",
    "!**/.*"
  ],
  "scripts": {
    "test": "jest",
    "typecheck": "tsc",
    "lint": "eslint \"**/*.{js,ts,tsx}\"",
    "lint:fix": "eslint \"**/*.{js,ts,tsx}\" --fix",
    "clean": "del-cli lib example/ios/build example/android/build",
    "prepare": "bob build",
    "release": "release-it --only-version",
    "build": "bob build",
    "build:plugin": "tsc --build plugin",
    "build:all": "yarn build && yarn build:plugin",
    "start": "yarn workspace react-native-deepgram-example start",
    "example": "yarn workspace react-native-deepgram-example",
    "example:ios": "yarn workspace react-native-deepgram-example ios",
    "example:android": "yarn workspace react-native-deepgram-example android",
    "example:prebuild": "yarn workspace react-native-deepgram-example prebuild",
    "example:start:built": "yarn workspace react-native-deepgram-example start:built",
    "example:clean": "yarn workspace react-native-deepgram-example clean"
  },
  "keywords": [
    "react-native",
    "ios",
    "android",
    "deepgram",
    "speech-to-text",
    "text-intelligence",
    "typescript",
    "speech",
    "transcription",
    "voice-recognition",
    "audio-processing",
    "real-time-transcription",
    "expo",
    "mobile-ai",
    "voice-to-text",
    "stt",
    "nlp",
    "sentiment-analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/itsRares/react-native-deepgram.git"
  },
  "author": "Rares Popa <rarpopa@hotmail.com> (https://github.com/itsRares)",
  "license": "MIT",
  "bugs": {
    "url": "https://github.com/itsRares/react-native-deepgram/issues"
  },
  "homepage": "https://github.com/itsRares/react-native-deepgram#readme",
  "publishConfig": {
    "registry": "https://registry.npmjs.org/"
  },
  "dependencies": {
    "buffer": "^6.0.3"
  },
  "devDependencies": {
    "@commitlint/config-conventional": "^21.2.4",
    "@eslint/compat": "^2.1.1",
    "@eslint/eslintrc": "^3.3.7",
    "@eslint/js": "^9.39.5",
    "@expo/config-plugins": "~58.0.12",
    "@react-native/babel-preset": "0.88.1",
    "@react-native/eslint-config": "0.88.1",
    "@react-native/jest-preset": "0.88.1",
    "@release-it/conventional-changelog": "^12.0.2",
    "@testing-library/react-native": "^14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "^19.2.0",
    "commitlint": "^21.2.4",
    "del-cli": "^8.0.1",
    "eslint": "^9.39.5",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-ft-flow": "^3.0.11",
    "eslint-plugin-prettier": "^5.5.7",
    "jest": "^30.5.2",
    "lefthook": "^2.2.2",
    "prettier": "^3.9.10",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-builder-bob": "^0.44.1",
    "release-it": "^21.1.2",
    "test-renderer": "^1.3.1",
    "turbo": "^2.11.10",
    "typescript": "^6.0.3"
  },
  "peerDependencies": {
    "@expo/config-plugins": "*",
    "react": ">=19.0.0",
    "react-native": ">=0.80.0"
  },
  "peerDependenciesMeta": {
    "@expo/config-plugins": {
      "optional": true
    }
  },
  "workspaces": [
    "example"
  ],
  "packageManager": "yarn@4.18.1",
  "jest": {
    "preset": "@react-native/jest-preset",
    "setupFiles": [
      "<rootDir>/jest/setup.ts"
    ],
    "modulePathIgnorePatterns": [
      "<rootDir>/example/node_modules",
      "<rootDir>/lib/"
    ]
  },
  "commitlint": {
    "extends": [
      "@commitlint/config-conventional"
    ]
  },
  "release-it": {
    "git": {
      "commitMessage": "chore: release ${version}",
      "tagName": "${version}"
    },
    "npm": {
      "publish": true
    },
    "github": {
      "release": true
    },
    "plugins": {
      "@release-it/conventional-changelog": {
        "preset": {
          "name": "angular"
        }
      }
    }
  },
  "prettier": {
    "quoteProps": "consistent",
    "singleQuote": true,
    "tabWidth": 2,
    "trailingComma": "es5",
    "useTabs": false
  },
  "react-native-builder-bob": {
    "source": "src",
    "output": "lib",
    "targets": [
      [
        "module",
        {
          "esm": true
        }
      ],
      [
        "typescript",
        {
          "project": "tsconfig.build.json"
        }
      ]
    ]
  },
  "codegenConfig": {
    "name": "DeepgramSpec",
    "type": "modules",
    "jsSrcsDir": "src",
    "android": {
      "javaPackageName": "com.deepgram"
    }
  },
  "create-react-native-library": {
    "type": "turbo-module",
    "languages": "kotlin-objc",
    "version": "0.64.0"
  }
}
